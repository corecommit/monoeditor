# Gradle
# NOTE: build outputs are ignored per module root only. A bare "build/"
# pattern would also ignore the source package
# core-compiler/src/main/kotlin/dev/mono/compiler/build/ (BuildEngine.kt),
# silently dropping it from version control.
.gradle/
/build/
app/build/
core-editor/build/
core-indexer/build/
core-compiler/build/
core-storage/build/
!gradle/wrapper/gradle-wrapper.jar

# Local configuration
local.properties

# IDE
.idea/
*.iml
.DS_Store
/captures/
.cxx/
.kotlin/

# Provisioned on-device toolchain (generated by toolchain/setup-toolchain.sh).
# A fresh clone builds a toolchain-less APK; run the script to bundle clang.
app/src/main/jniLibs/
app/src/main/assets/toolchain/
toolchain/work/
